{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.8",
  "default_locale": "zh_CN",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "alarms",
    "debugger",
    "scripting",
    "tabs",
    "proxy",
    "privacy",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "web_accessible_resources": []
}
